# Runtime
NODE_ENV=development
PORT=3000

# Manus OAuth / session
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=

# Database (required when auth/database features are used)
DATABASE_URL=

# Manus Forge services used by built-in storage/notification integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Client analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Yandex SMTP application password (server-only; never use a VITE_ prefix)
YANDEX_SMTP_APP_PASSWORD=
